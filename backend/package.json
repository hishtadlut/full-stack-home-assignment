{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "Task Manager API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:assistant:mock",
    "test:request-body": "tsx src/middleware/requestBody.test.ts",
    "test:assistant:mock": "tsx src/assistant/draftValidator.test.ts",
    "test:assistant:live": "tsx src/assistant/liveAssistant.test.ts",
    "start": "node dist/server.js",
    "db:docker:up": "docker-compose up -d",
    "db:docker:down": "docker-compose down",
    "db:docker:restart": "docker-compose restart",
    "db:setup": "npm run db:docker:up && sleep 5 && npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.24",
    "prisma": "^6.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
